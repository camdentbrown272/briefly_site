---
import Base from '../layouts/Base.astro';
import Waitlist from '../components/Waitlist.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import FeatureRequest from '../components/FeatureRequest.astro';
import { site, links, shots, heroShot, product } from '../config';

const year = new Date().getFullYear();
const awaitingShots = shots.every((shot) => shot.src === null);

const pillars = [
  {
    title: 'Quotes, actually attributed',
    body: 'Direct quotes from founders and operators, with the person and the source attached. If it can’t be traced back, it doesn’t go in.',
  },
  {
    title: 'Reframes, not affirmations',
    body: 'A different angle on something you’re stuck on. Not “believe in yourself” — a specific way to look at a specific problem.',
  },
  {
    title: 'The non-obvious part',
    body: 'Compressed lessons that normally take a few years and one expensive decision to learn on your own.',
  },
];

const steps = [
  {
    title: 'Fifteen posts, hand-picked',
    body: 'Chosen for signal, not for stickiness. Nothing makes the cut because it performs well — it makes the cut because it earns the sixty seconds.',
  },
  {
    title: 'It resets at midnight, your time',
    body: 'A new set tomorrow. Miss a day and it’s gone — there’s no backlog waiting to guilt you into catching up.',
  },
  {
    title: 'The end is a real end',
    body: 'Last card, then a screen that tells you you’re done for the day. That’s not a limitation. That’s the whole design.',
  },
];
---

<Base>
  <header class="masthead">
    <div class="wrap masthead__inner">
      <a class="wordmark" href="/">{site.name}<span class="wordmark__dot">.</span></a>
      <nav class="masthead__links">
        {
          links.instagram && (
            <a class="masthead__link" href={links.instagram} target="_blank" rel="noopener noreferrer" aria-label="Briefly on Instagram (opens in a new tab)">
              Instagram
            </a>
          )
        }
        {
          links.x && (
            <a class="masthead__link" href={links.x} target="_blank" rel="noopener noreferrer" aria-label="Briefly on X (opens in a new tab)">
              X
            </a>
          )
        }
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ---------------------------------------------------------- hero -->
    <section class="section hero">
      <div class="wrap hero__inner">
        <div class="hero__copy">
        <p class="eyebrow" data-reveal style="--i:0">In development</p>
        <h1 class="hero__title" data-reveal style="--i:1">A feed<br />that ends.</h1>
        <p class="lede hero__lede" data-reveal style="--i:2">
          {site.name} is fifteen posts a day about entrepreneurship, business, and making money. Read
          them, close the app, go back to work. There is nothing after the fifteenth card &mdash; no
          infinite scroll, no algorithm quietly learning what keeps you here.
        </p>

        <div class="hero__form" data-reveal style="--i:3">
          <Waitlist source="hero" />
        </div>

        <ul class="facts" data-reveal style="--i:4">
          <li class="fact"><strong data-ticker="15">15</strong><span>posts a day</span></li>
          <li class="fact"><strong>0</strong><span>ads or algorithms</span></li>
          <li class="fact"><strong>{product.launchOffer}</strong><span>{product.launchOfferDetail}</span></li>
        </ul>
        </div>

        <div class="hero__device" data-reveal style="--i:3">
          <PhoneFrame shot={heroShot} eager />
        </div>
      </div>
    </section>

    <hr class="rule" />

    <!-- -------------------------------------------------------- premise -->
    <section class="section">
      <div class="wrap split">
        <div class="split__aside">
          <p class="eyebrow">The premise</p>
        </div>
        <div class="split__main">
          <h2 data-reveal>Every other feed is built to never end.</h2>
          <div class="prose" data-reveal style="--i:1">
            <p>
              That is not a bug in the design, it is the design. The longer you stay, the more time
              you lose on the thing you were actually trying to build. So you open an app to learn
              one useful thing and leave forty minutes later having learned none of them.
            </p>
            <p>
              {site.name} runs the other way around. A fixed number of cards, curated once a day.
              The best possible outcome for us is that you close it.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- -------------------------------------------------------- pillars -->
    <section class="section band">
      <div class="wrap">
        <p class="eyebrow">What&rsquo;s in the fifteen</p>
        <h2 class="band__title" data-reveal>Three kinds of card. Nothing else.</h2>
        <ol class="pillars">
          {
            pillars.map((pillar, index) => (
              <li class="pillar" data-reveal style={`--i:${index}`}>
                <span class="pillar__num">{String(index + 1).padStart(2, '0')}</span>
                <h3>{pillar.title}</h3>
                <p>{pillar.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ---------------------------------------------------- screenshots -->
    <section class="section">
      <div class="wrap">
        <p class="eyebrow">A look at it</p>
        <h2 class="centered-title" data-reveal>Open it, finish it, leave.</h2>
        {
          awaitingShots && import.meta.env.DEV && (
            <p class="devnote">
              {'Dev-only note: these are placeholder frames. Drop real exports in '}
              <code>public/screenshots/</code>
              {' and point '}
              <code>shots[].src</code>
              {' at them in '}
              <code>src/config.ts</code>
              {'. This note never appears in a production build.'}
            </p>
          )
        }
        <div class="shots">
          {
            shots.map((shot, index) => (
              <div class="shot" data-reveal style={`--i:${index}`}>
                <PhoneFrame shot={shot} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <hr class="rule" />

    <!-- ---------------------------------------------------------- steps -->
    <section class="section">
      <div class="wrap split">
        <div class="split__aside">
          <p class="eyebrow">How the day works</p>
        </div>
        <div class="split__main">
          <div class="timeline">
            <span class="timeline__beam" aria-hidden="true"></span>
            <ol class="steps">
            {
              steps.map((step) => (
                <li class="step" data-reveal>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </li>
              ))
            }
          </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------ feature requests -->
    <section class="section band">
      <div class="wrap split">
        <div class="split__aside">
          <p class="eyebrow">Requests</p>
        </div>
        <div class="split__main">
          <h2 data-reveal>Want a new feature or have an issue?</h2>
          <div class="prose" data-reveal style="--i:1">
            <p>
              Tell us what would make {site.name} worth opening, or who you want writing on it.
              Write it here and it goes straight to us.
            </p>
          </div>
          <div data-reveal style="--i:2"><FeatureRequest /></div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------- honesty -->
    <section class="section">
      <div class="wrap split">
        <div class="split__aside">
          <p class="eyebrow">Straight up</p>
        </div>
        <div class="split__main">
          <h2 data-reveal>Where the writing comes from.</h2>
          <div class="prose" data-reveal style="--i:1">
            <p>
              Right now the cards are AI-generated, built on real-world ideologies and real
              attributed quotes &mdash; and every single one says so on its face. We would rather
              tell you that here than have you work it out later.
            </p>
            <p>
              The plan is to replace it with the real thing: founders and operators writing
              directly. That part is in progress now. People on this list get in first, at the price
              before it moves.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------ final CTA -->
    <section class="section closer">
      <div class="wrap closer__inner">
        <h2 class="closer__title" data-reveal>Fifteen a day.<br />Then you&rsquo;re done.</h2>
        <div class="closer__form" data-reveal style="--i:1">
          <Waitlist source="footer" />
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <p class="footer__mark">{site.name}<span class="wordmark__dot">.</span></p>
      <p class="footer__disclosure">AI generated content based on real-world ideologies.</p>
      <p class="footer__business">
        Briefly is run by Camden Brown and Kasen Afflerbach in Texas, USA.
        <a href="mailto:hello@brieflysite.com">hello@brieflysite.com</a>
      </p>
      <nav class="footer__links">
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        {
          links.instagram && (
            <a href={links.instagram} target="_blank" rel="noopener noreferrer" aria-label="Briefly on Instagram (opens in a new tab)">
              Instagram
            </a>
          )
        }
        {
          links.x && (
            <a href={links.x} target="_blank" rel="noopener noreferrer" aria-label="Briefly on X (opens in a new tab)">
              X
            </a>
          )
        }
        {links.email && <a href={`mailto:${links.email}`}>Email</a>}
        <span class="footer__copy">&copy; {year}</span>
      </nav>
    </div>
  </footer>
</Base>

<script>
  const motion = document.documentElement.classList.contains('motion');
  const canObserve = 'IntersectionObserver' in window;
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

  // Blur fade: reveal each marked element once, as it enters the viewport.
  const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (!motion || !canObserve) {
    reveals.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
    );
    reveals.forEach((el) => io.observe(el));
  }
  clearTimeout((window as unknown as { __revealFallback?: number }).__revealFallback);

  // Number ticker: count up once, easing out. The real value is in the HTML,
  // so without motion nothing changes.
  if (motion && canObserve) {
    document.querySelectorAll<HTMLElement>('[data-ticker]').forEach((el) => {
      const target = Number(el.dataset.ticker);
      el.textContent = '0';
      const io = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        io.disconnect();
        const start = performance.now() + 450;
        const tick = (now: number) => {
          const t = Math.min(1, Math.max(0, (now - start) / 1400));
          const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
          el.textContent = String(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
      io.observe(el);
    });
  }

  if (motion && finePointer) {
    // Spotlight: feed the cursor position to each pillar's glow.
    document.querySelectorAll<HTMLElement>('.pillar').forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const box = card.getBoundingClientRect();
        card.style.setProperty('--x', `${event.clientX - box.left}px`);
        card.style.setProperty('--y', `${event.clientY - box.top}px`);
      });
    });

    // 3D tilt: lean each gallery phone a few degrees toward the cursor.
    document.querySelectorAll<HTMLElement>('.shot').forEach((shot) => {
      const phone = shot.querySelector<HTMLElement>('.phone__body');
      if (!phone) return;
      shot.addEventListener('pointermove', (event) => {
        const box = phone.getBoundingClientRect();
        const x = (event.clientX - box.left) / box.width - 0.5;
        const y = (event.clientY - box.top) / box.height - 0.5;
        phone.style.transform = `perspective(900px) rotateY(${x * 10}deg) rotateX(${y * -8}deg)`;
      });
      shot.addEventListener('pointerleave', () => {
        phone.style.transform = '';
      });
    });
  }

  // Tracing beam: the line fills as you scroll through the day, and each
  // step's marker lights when the line reaches it.
  const timeline = document.querySelector<HTMLElement>('.timeline');
  if (timeline && motion) {
    const steps = timeline.querySelectorAll<HTMLElement>('.step');
    let queued = false;
    const update = () => {
      queued = false;
      const line = innerHeight * 0.62;
      const box = timeline.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, (line - box.top) / box.height));
      timeline.style.setProperty('--progress', progress.toFixed(3));
      steps.forEach((step) => {
        step.classList.toggle('is-lit', step.getBoundingClientRect().top + 12 < line);
      });
    };
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    update();
  } else if (timeline) {
    timeline.querySelectorAll('.step').forEach((step) => step.classList.add('is-lit'));
  }
</script>

<style>
  /* --- masthead --- */
  .masthead {
    padding-block: 1.5rem;
  }

  .masthead__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .wordmark__dot {
    color: var(--accent);
  }

  .masthead__links {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .masthead__link {
    font-size: 0.9rem;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
    padding-bottom: 1px;
  }

  .masthead__link:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  /* --- hero --- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(4rem, 10vw, 7rem);
  }

  /* Dot pattern: texture, not decoration — it fades out long before the
     text, so it never sits behind anything you have to read. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(var(--dot) 1px, transparent 1.3px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 55% 70% at 78% 45%, #000 20%, transparent 72%);
    mask-image: radial-gradient(ellipse 55% 70% at 78% 45%, #000 20%, transparent 72%);
  }

  /* Border beam: a slow light tracing the hero phone's frame. */
  :global(.motion) .hero__device :global(.phone__body)::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1.5px;
    pointer-events: none;
    background: conic-gradient(
      from var(--beam-angle),
      transparent 0deg 290deg,
      var(--accent) 335deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    animation: beam 9s linear infinite;
  }

  @keyframes beam {
    to {
      --beam-angle: 360deg;
    }
  }

  .hero__inner {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: 4rem;
    }
  }

  /* A phone next to the headline is redundant when you're holding one. */
  .hero__device {
    display: none;
  }

  @media (min-width: 60rem) {
    .hero__device {
      display: block;
    }
  }

  .hero__title {
    margin-top: 1.25rem;
  }

  .hero__lede {
    margin-top: 1.5rem;
  }

  .hero__form {
    margin-top: 2.25rem;
  }

  /* Narrow screens: one fact per row, value and label on a shared baseline.
     Three side-by-side columns don't fit and leave an orphan. */
  .facts {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .fact {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 0.75rem;
  }

  .fact strong {
    font-variant-numeric: tabular-nums;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1;
    color: var(--accent);
    min-width: 4.5ch;
  }

  @media (min-width: 40rem) {
    .facts {
      flex-direction: row;
      flex-wrap: wrap;
      gap: clamp(1.5rem, 5vw, 3.5rem);
    }

    .fact {
      flex-direction: column;
      gap: 0.15rem;
    }

    .fact strong {
      min-width: 0;
    }
  }

  .fact span {
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* --- shared section furniture --- */
  .band {
    background: var(--paper-sunk);
    border-block: 1px solid var(--rule);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .split__main {
    max-width: 40rem;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 1.5rem;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }

  @media (min-width: 48rem) {
    .split {
      grid-template-columns: 12rem 1fr;
      gap: 3rem;
    }

    .split__aside .eyebrow {
      padding-top: 0.7rem;
    }
  }

  /* --- pillars --- */
  .band__title {
    margin-top: 1.25rem;
    max-width: 24ch;
  }

  .pillars {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 0;
    display: grid;
    /* Each pillar carries its own padding for the spotlight glow, so the
       stacked mobile gap can be small. */
    gap: 0.75rem;
  }

  @media (min-width: 46rem) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  /* Spotlight card: a soft glow follows the cursor across each pillar.
     The negative margin buys room for the glow without moving the text. */
  .pillar {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem 1rem 1.5rem;
    margin-inline: -1rem;
    border-radius: 0 0 14px 14px;
  }

  .pillar::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: 1rem;
    border-top: 1px solid var(--rule-strong);
    transition: border-color 0.35s ease;
  }

  .pillar::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    background: radial-gradient(
      240px circle at var(--x, 50%) var(--y, 0%),
      var(--accent-wash),
      transparent 70%
    );
  }

  .pillar:hover::before {
    border-color: var(--accent);
  }

  :global(.motion) .pillar:hover::after {
    opacity: 1;
  }

  .pillar__num {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .pillar p {
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  /* --- screenshots --- */
  .centered-title {
    margin-top: 1.25rem;
  }

  .shots {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
  }

  /* 3D tilt: the gallery phones lean toward the cursor. */
  :global(.motion) .shot :global(.phone__body) {
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: transform;
  }

  :global(.motion) .shot:hover :global(.phone__body) {
    transition-duration: 0.15s;
  }

  .devnote {
    margin-top: 1.5rem;
    max-width: var(--measure);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--ink-soft);
    background: var(--accent-wash);
    border: 1px dashed var(--accent);
    border-radius: 10px;
    padding: 0.85rem 1rem;
  }

  .devnote code {
    font-size: 0.95em;
  }

  /* --- steps: tracing beam --- */
  .timeline {
    --progress: 1;
    position: relative;
    padding-left: 2rem;
  }

  :global(.motion) .timeline {
    --progress: 0;
  }

  .timeline::before,
  .timeline__beam {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.7rem;
    bottom: 0.7rem;
    width: 1px;
  }

  .timeline::before {
    background: var(--rule-strong);
  }

  .timeline__beam {
    background: linear-gradient(to bottom, transparent, var(--accent) 12%);
    box-shadow: 0 0 10px var(--accent);
    transform-origin: top;
    transform: scaleY(var(--progress));
  }

  .step {
    position: relative;
  }

  .step::before {
    content: '';
    position: absolute;
    left: calc(-2rem);
    top: calc(1.75rem + 0.3rem);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    transition:
      background 0.4s ease,
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .step:first-child::before {
    top: 0.3rem;
  }

  .step.is-lit::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-wash);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .step:first-child {
    padding-top: 0;
  }

  .step:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .step p {
    color: var(--ink-soft);
    max-width: 46ch;
  }

  /* --- closer --- */
  .closer__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 52rem) {
    .closer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .closer__title {
    max-width: 20ch;
  }

  /* --- footer --- */
  .footer {
    border-top: 1px solid var(--rule);
    padding-block: 2.5rem 3.5rem;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
